# Server Configuration
PORT=3000
NODE_ENV=development
SESSION_SECRET=replace_with_64_char_random_hex_secret
CORS_ORIGIN=http://localhost:3001
# Reverse Proxy Trust: false (direct), 1 (single reverse proxy like Nginx/ALB/Render), or CIDR/loopback
TRUST_PROXY=false

# API Rate Limiting (Shared MongoDB store recommended for multi-instance production)
RATE_LIMIT_STORE=mongo
RATE_LIMIT_API_WINDOW_MS=900000
RATE_LIMIT_API_MAX=300
RATE_LIMIT_OTP_REQUEST_WINDOW_MS=900000
RATE_LIMIT_OTP_REQUEST_MAX=10
RATE_LIMIT_OTP_VERIFY_WINDOW_MS=900000
RATE_LIMIT_OTP_VERIFY_MAX=15
RATE_LIMIT_MUTATION_WINDOW_MS=60000
RATE_LIMIT_MUTATION_MAX=60
RATE_LIMIT_WEBHOOK_WINDOW_MS=60000
RATE_LIMIT_WEBHOOK_MAX=600

# Database
MONGODB_URI=mongodb://localhost:27017/restaurant_money_management

# WhatsApp Cloud API Configuration
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_API_VERSION=v21.0
WHATSAPP_API_BASE_URL=https://graph.facebook.com

# AI Integration (OpenAI GPT-4o-mini & Whisper)
OPENAI_API_KEY=your_openai_api_key

# Object Storage (S3-compatible: AWS S3, Cloudflare R2, MinIO)
STORAGE_BUCKET=restaurant-receipts-media
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY=your_storage_access_key
STORAGE_SECRET_KEY=your_storage_secret_key
STORAGE_ENDPOINT=

# Restaurant Money Management Defaults
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
